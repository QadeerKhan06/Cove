<Window x:Class="Cove.UI.Pill.PillWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:kit="clr-namespace:Cove.UI.Kit"
        Title="Cove"
        AutomationProperties.Name="Cove"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Width="{StaticResource PillWindowWidth}"
        Height="{StaticResource PillWindowHeight}"
        UseLayoutRounding="True"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False">
  <!-- The window is a fixed, fully see-through area big enough for the largest panel; only the
       surface inside it is drawn. Windows passes clicks on fully transparent pixels through to the
       app underneath, so keep everything outside the surface fully transparent (CLAUDE.md 9.5, 11.1). -->
  <Grid Margin="{StaticResource PillTopGap}">
    <!-- One surface for every state: it changes size and shape, and its content is swapped. -->
    <kit:CapsuleBorder x:Name="Surface"
                       Style="{StaticResource PillAlertSurfaceStyle}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top"
                       ClipToBounds="True">
      <kit:CapsuleBorder.RenderTransform>
        <TranslateTransform x:Name="Slide" />
      </kit:CapsuleBorder.RenderTransform>
    </kit:CapsuleBorder>
  </Grid>
</Window>
